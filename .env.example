# Для запуска воркера в одиночку (без docker-compose из notrecinema-api).
# В составе docker-compose обычно используется notrecinema-api/.env --
# см. секцию `worker` в notrecinema-api/docker-compose.yml.

DATABASE_URL=postgresql://app_user:change-me-too@localhost:5433/notrecinema
NATS_URL=nats://localhost:4222
MAX_DELIVER=5
LOG_LEVEL=info
OTLP_ENDPOINT=localhost:4318

# VAPID-ключи для web push -- та же пара, что и в notrecinema-app.
# Опциональны: без них internal/webpush просто не отправляет уведомления,
# не падает.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Почта через Resend. Опционально: без RESEND_API_KEY письма отключены
# (подтверждение email, сброс пароля, уведомления), остальное работает.
# Домен в MAIL_FROM должен быть подтверждён в Resend.
RESEND_API_KEY=
MAIL_FROM=notrecinema <noreply@notrecinema.ru>
MAIL_REPLY_TO=
# Адрес фронтенда без слэша на конце: на него ведут ссылки в письмах.
APP_URL=http://localhost:3000

# Секрет подписи ссылок «отписаться» в письмах. ОДИН И ТОТ ЖЕ у API (проверяет
# ссылку) и воркера (подписывает её).
# Обязателен, когда задан RESEND_API_KEY: воркер без него не стартует.
# Сменить значение можно в любой момент, но все выданные ранее ссылки
# отписки перестанут работать. Сгенерировать: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
