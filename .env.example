# Для запуска воркера в одиночку (без docker-compose из notrecinema-api).
# В составе docker-compose обычно используется notrecinema-api/.env --
# см. секцию `worker` в notrecinema-api/docker-compose.yml.

DATABASE_URL=postgresql://app_user:change-me-too@localhost:5433/notrecinema
NATS_URL=nats://localhost:4222
MAX_DELIVER=5
LOG_LEVEL=info
OTLP_ENDPOINT=localhost:4318

# VAPID-ключи для web push -- та же пара, что и в notrecinema-app.
# Опциональны: без них internal/webpush просто не отправляет уведомления,
# не падает.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
